{
  "name": "simple-agent-orchestrator",
  "version": "0.1.0",
  "description": "sao — simple agent orchestrator: a minimal YAML workflow engine for AI coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimbener/simple-agent-orchestrator.git"
  },
  "homepage": "https://github.com/rimbener/simple-agent-orchestrator#readme",
  "bugs": "https://github.com/rimbener/simple-agent-orchestrator/issues",
  "keywords": [
    "agents",
    "ai",
    "claude",
    "codex",
    "orchestrator",
    "workflow",
    "yaml",
    "cli"
  ],
  "type": "module",
  "bin": {
    "sao": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "test:orchestrator": "bun test --only-failures",
    "test:orchestrator:ci": "bun test --only-failures --rerun-each=2",
    "test:coverage": "bun test --coverage",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check src tests",
    "lint:fix": "biome check src tests --write",
    "format": "biome format src tests",
    "format:fix": "biome format src tests --write",
    "build": "bun build src/cli.ts --outdir dist --target node",
    "prepack": "bun run build",
    "bootstrap": "bun run format && bun run lint && bun run typecheck && bun test --only-failures && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@clack/prompts": "^1.7.0",
    "@hughescr/stryker-bun-runner": "^1.3.8",
    "@stryker-mutator/core": "^9.6.1",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "patchedDependencies": {
    "@zed-industries/agent-client-protocol@0.4.5": "patches/@zed-industries%2Fagent-client-protocol@0.4.5.patch"
  }
}